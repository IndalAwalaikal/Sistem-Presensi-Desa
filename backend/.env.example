# =====================================================================
# Contoh konfigurasi backend — salin menjadi .env lalu isi nilai aslinya.
# JANGAN pernah commit berkas .env berisi nilai asli ke repositori.
# =====================================================================

# Server
PORT=8080
# Origin frontend yang boleh memanggil API (pisahkan dengan koma).
# Untuk produksi, ganti dengan origin HTTPS frontend yang sebenarnya.
# Kosongkan bila frontend dilayani dari origin yang sama (same-origin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3080

# MySQL — semua kredensial basis data diambil dari env, tidak pernah ditulis
# di dalam kode.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=presensi_anabanua
DB_USER=presensi
DB_PASSWORD=ubah-saya
# Variabel MYSQL_* dipakai image MySQL saat membuat basis data pertama kali.
# Samakan MYSQL_DATABASE/USER/PASSWORD dengan DB_NAME/USER/PASSWORD di atas.
MYSQL_DATABASE=presensi_anabanua
MYSQL_USER=presensi
MYSQL_PASSWORD=ubah-saya
MYSQL_ROOT_PASSWORD=ganti-dengan-sandi-root-yang-kuat

# Akun admin awal dibuat hanya jika belum ada. Tetapkan sandi yang kuat.
SEED_SEKRETARIS_EMAIL=sekretaris@anabanua.id
SEED_SEKRETARIS_NAMA=Sekretaris Desa
SEED_SEKRETARIS_NIP=-
SEED_SEKRETARIS_SANDI=ganti-dengan-sandi-kuat
SEED_KEPALA_EMAIL=kepala@anabanua.id
SEED_KEPALA_NAMA=Kepala Desa
SEED_KEPALA_NIP=-
SEED_KEPALA_SANDI=ganti-dengan-sandi-kuat

# Keamanan token
# WAJIB: minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
JWT_SECRET=GANTI-DENGAN-KUNCI-ACAK-MINIMAL-32-KARAKTER
JWT_TTL_JAM=12

# Biaya bcrypt (10–14). Semakin besar semakin lambat namun semakin kuat.
BCRYPT_COST=12

# Batas percobaan masuk per IP dan per pasangan IP+email dalam jendela waktu (detik).
LOGIN_RATE_MAX=8
LOGIN_RATE_IP_MAX=40
LOGIN_RATE_WINDOW_DETIK=300

# Proxy terpercaya untuk header X-Forwarded-For (alamat atau blok CIDR,
# dipisah koma). KOSONGKAN bila API diakses langsung seperti pada compose ini:
# header itu lalu diabaikan dan alamat koneksi langsung yang dipakai. Isi hanya
# bila ada reverse proxy/ingress di depan (mis. 10.0.0.0/8) — tanpa daftar ini
# penyerang mengarang alamat di setiap permintaan dan pembatas laju login
# dilewati sepenuhnya.
TRUSTED_PROXIES=

# Batas ukuran isi permintaan (mega-bita) — enrollment mengirim foto base64.
MAX_BODY_MB=8

# Layanan AI (Python). Produksi wajib memakai layanan ini; mode tanpa AI hanya
# untuk pengembangan dan mempercayai skor dari klien.
AI_BASE_URL=http://127.0.0.1:8100
AI_API_KEY=ganti-dengan-kunci-api-ai
AI_TIMEOUT_MS=4000

# Ambang biometrik: AMBANG_WAJAH memakai cosine mentah -1..1 (bukan persen).
# Nilai harus dikalibrasi pada foto autentik dan percobaan tidak sah di lapangan.
# AMBANG_LIVENESS adalah heuristik tekstur sementara, bukan jaminan anti-spoof.
AMBANG_WAJAH=0.62
AMBANG_LIVENESS=0.5

# Sumber resmi kalender hari libur (dipakai tombol \"Tarik kalender resmi\" di
# halaman Hari Libur). Kosongkan untuk mematikan impor — kalender bawaan
# (SKB, disemai otomatis) dan suntingan manual tetap berjalan penuh.
LIBUR_API_URL=https://api-hari-libur.vercel.app/api

# Webhook kedisiplinan (mis. gateway WhatsApp atau bot Telegram desa).
# Kosong = fitur dimatikan: tidak ada kabar yang dikirim, sedangkan seluruh
# perhitungan kedisiplinan tetap berjalan seperti biasa.
# Kabar dikirim dalam bentuk JSON:
#   { "jenis": "PRESENSI" | "RINGKASAN_HARIAN", "tanggal": "YYYY-MM-DD",
#     "pesan": "<teks siap kirim>", "baris": [ { "userId", "nama", "jenis",
#     "waktu", "selisihMenit", "catatan" } ] }
# Token (bila diisi) dikirim sebagai Authorization: Bearer dan X-Webhook-Token.
DISIPLIN_WEBHOOK_URL=
DISIPLIN_WEBHOOK_TOKEN=
DISIPLIN_WEBHOOK_TIMEOUT_MS=6000

# Kantor (dipakai saat penyemaian pertama; setelah itu tersimpan di DB dan
# diatur dari aplikasi).
KANTOR_NAMA=Kantor Desa Anabanua
KANTOR_LAT=-4.4680072
KANTOR_LNG=119.713862
KANTOR_RADIUS_M=100
AKURASI_MAKS_M=50
