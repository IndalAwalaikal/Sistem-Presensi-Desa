# Salin menjadi .env.local untuk menjalankan frontend di luar Docker.
#
# API_MODE=http  → seluruh data dinamis dari backend Go (bawaan, wajib produksi)
# API_MODE=mock  → data contoh lokal, hanya untuk mengembangkan tampilan
#                  tanpa backend. Jangan dipakai pada aplikasi yang dipakai desa.
NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
